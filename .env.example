# Copiar a .env.local y completar. Las variables sin NEXT_PUBLIC_ nunca llegan al navegador.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solo tooling local (scripts/db-migrate.mjs). No se configura en Vercel.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Cloudinary (subidas firmadas desde el servidor; no se usa upload preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=imagenes

# Sitio
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=
# Firma los links de confirmación de pedido (cualquier texto largo y aleatorio)
ORDER_LINK_SECRET=

# Correos de pedido (a la tienda y al cliente) por SMTP. Gratis con Gmail: contraseña de aplicación de
# la cuenta de la tienda (myaccount.google.com/apppasswords, requiere verificación en 2 pasos).
# Sin SMTP_USER/SMTP_PASSWORD no se envían correos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opcionales: remitente ("Time Relojería <correo>") y destino del aviso (por defecto, el correo de Ajustes)
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=

# Verificador de Cloudflare Turnstile en el ingreso al panel (plan gratuito). Sin claves no se exige.
# Claves de prueba de Cloudflare para desarrollo: sitio 1x00000000000000000000AA, secreto
# 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Asistente de IA por WhatsApp (Anthropic). Sin clave, los mensajes quedan para el equipo.
ANTHROPIC_API_KEY=

# WhatsApp: meta (Cloud API directa), 360dialog o sandbox (modo prueba, no envía nada).
WHATSAPP_PROVIDER=sandbox
# Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Firma de los webhooks (App Secret de la app de Meta) y token de verificación al registrarlo
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 360dialog: API key y token secreto que va al final de la URL del webhook (?token=...)
D360_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
