{
  "name": "time",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/db-migrate.mjs --check",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:test": "node scripts/db-migrate.mjs --test",
