    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.21",
    "axe-core": "^4.13.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.3",
    "vitest": "^5.0.1"
