    "demo:seed": "node scripts/demo-catalog.mjs",
    "demo:remove": "node scripts/demo-catalog.mjs --remove",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e:tienda": "node tests/e2e/tienda.mjs",
    "e2e:panel": "node tests/e2e/panel.mjs",
    "e2e:crm": "node tests/e2e/crm.mjs",
    "e2e": "node tests/e2e/tienda.mjs && node tests/e2e/panel.mjs && node tests/e2e/crm.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "1.1.14",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "2.1.1",
    "lucide-react": "0.462.0",
    "next": "16.3.5",
